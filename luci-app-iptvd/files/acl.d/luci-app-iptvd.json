{
	"luci-app-iptvd": {
		"description": "Allow reading and controlling the iptvd service",
		"read": {
			"ubus": {
				"iptvd": [ "status", "get_config", "get_raw", "log", "uplink", "service" ]
			}
		},
		"write": {
			"ubus": {
				"iptvd": [ "set_config", "set_raw", "action", "service" ]
			}
		}
	}
}
