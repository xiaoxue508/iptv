#!/bin/sh /etc/rc.common
# iptvd - IPTV control plane daemon

USE_PROCD=1
START=95
STOP=10

start_service() {
	[ -x /usr/sbin/iptvd ] || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/iptvd serve
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	[ -f /etc/iptvd.conf ] && procd_set_param file /etc/iptvd.conf
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger iptvd
}

# NOTE: the source rule (pref 1000 -> table 1001) installed by iptvd is left
# in place on stop on purpose - it only matches packets sourced from the
# uplink address (iptvd, r2h) and is re-proven/updated on next start.
