#!/bin/sh
# rpcd exec plugin: ubus object "iptvd", method "status"
# Queries the LIVE serve daemon via /status.json. Running the CLI here would
# report this throwaway process instead (uptime 0 / no session / not ready).
# stdout must be exactly one JSON value.

case "$1" in
list)
	echo '{"status": {}}'
	;;
call)
	case "$2" in
	status)
		port="$(sed -n 's/^port[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' /etc/iptvd.conf 2>/dev/null | head -n1)"
		[ -n "$port" ] || port=5150
		wget -q -T 5 -O - "http://127.0.0.1:${port}/status.json" 2>/dev/null || echo '{}'
		;;
	esac
	;;
esac
